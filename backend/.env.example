PORT=5000

DB_HOST=localhost
DB_NAME=my_database
DB_USER=my_user
DB_PASS=my_password
DB_DIALECT=mysql

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
SESSION_SECRET=your_session_secret

FRONTEND_URL=http://localhost:8080

# --- Market data (Finnhub) -------------------------------------------------
# Server-side only. Never prefix with VITE_ — that would ship the key to every
# browser. Get a key at https://finnhub.io/dashboard
FINNHUB_API_KEY=

# Symbol universe for the dashboard. Comma-separated, optional.
# Finnhub's free tier covers US equities; NSE/BSE symbols need a paid plan.
MARKET_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,WMT
MARKET_INDICES=SPY,DIA,QQQ

# ---------------------------------------------------------------------------
# Document storage (AWS S3)
# ---------------------------------------------------------------------------
# S3 is used only when ACCESS_KEY, SECRET_KEY and BUCKET are all set; otherwise
# the app falls back to local disk using the identical key layout, so nothing
# else has to change. Never commit real values — set them in .env only.
#
# The bucket must stay PRIVATE (Block Public Access on, ACLs disabled). Reads
# are served through GET /api/files/view/<key>, which checks ownership and then
# redirects to a short-lived presigned URL.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Lifetime of a presigned download URL, in seconds.
AWS_S3_SIGNED_URL_TTL=300
# Absolute base the browser should use for stored files, e.g.
# https://api.protocall.in/api — derived from the request when unset.
PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Token lifetimes
# ---------------------------------------------------------------------------
# The access token is intentionally short: it cannot be revoked, so its window
# of usefulness if stolen is its lifetime. The refresh token carries the session
# and can be revoked server-side (see oauth_tokens).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email sender. On AWS SES the SMTP username is a credential id, not an
# address, so the From address must be configured separately — using the
# username produced "501 Invalid MAIL FROM address provided" on every send.
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Protocall
