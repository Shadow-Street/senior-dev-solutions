PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=my_database
DB_USER=my_user
DB_PASSWORD=my_password
DB_DIALECT=mysql

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
SESSION_SECRET=your_session_secret

FRONTEND_URL=http://localhost:8080

# --- Market data (Finnhub) -------------------------------------------------
# Server-side only. Never prefix with VITE_ — that would ship the key to every
# browser. Get a key at https://finnhub.io/dashboard
FINNHUB_API_KEY=
# Marketaux Indian market news (https://www.marketaux.com). Free plan: 100 requests/day, 3 articles/request.
MARKETAUX_API_KEY=
MARKETAUX_MAX_LIMIT=
MARKETAUX_CACHE_TTL_SECONDS=
MARKETAUX_DAILY_BUDGET=
MARKETAUX_BURST_PER_MINUTE=
# DhanHQ v2 market data (needs the Data APIs subscription). Credentials are kept ENCRYPTED in the
# database (table provider_credentials, migration 015) and renewed automatically; paste the token in
# Super Admin > Platform Settings > Market Data (Dhan). MARKET_DATA_KEY is required for that: 32 bytes,
# 64 hex chars or base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
# Without it Dhan stays disabled. Losing/rotating the key means pasting the token again.
MARKET_DATA_KEY=
# Optional, one-time bootstrap only: if the table has no Dhan row, these are imported into it at startup
# (then superseded by the stored, auto-renewed token - remove DHAN_ACCESS_TOKEN afterwards).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_INSTRUMENT_CACHE_DIR=

# Symbol universe for the dashboard. Comma-separated, optional.
# Finnhub's free tier covers US equities; NSE/BSE symbols need a paid plan.
MARKET_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,NVDA,META,TSLA,JPM,V,WMT
MARKET_INDICES=SPY,DIA,QQQ

# ---------------------------------------------------------------------------
# Document storage (AWS S3)
# ---------------------------------------------------------------------------
# S3 is used only when ACCESS_KEY, SECRET_KEY and BUCKET are all set; otherwise
# the app falls back to local disk using the identical key layout, so nothing
# else has to change. Never commit real values — set them in .env only.
#
# The bucket must stay PRIVATE (Block Public Access on, ACLs disabled). Reads
# are served through GET /api/files/view/<key>, which checks ownership and then
# redirects to a short-lived presigned URL.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Lifetime of a presigned download URL, in seconds.
AWS_S3_SIGNED_URL_TTL=300
# Absolute base the browser should use for stored files, e.g.
# https://api.protocall.in/api — derived from the request when unset.
PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Token lifetimes
# ---------------------------------------------------------------------------
# The access token is intentionally short: it cannot be revoked, so its window
# of usefulness if stolen is its lifetime. The refresh token carries the session
# and can be revoked server-side (see oauth_tokens).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email sender. On AWS SES the SMTP username is a credential id, not an
# address, so the From address must be configured separately — using the
# username produced "501 Invalid MAIL FROM address provided" on every send.
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Protocall

# ---------------------------------------------------------------------------
# Runtime / security (added 2026-10-25 — see docs/security/remediation-plan.md)
# ---------------------------------------------------------------------------
# "production" enables secure cookies and fail-fast checks for missing secrets.
NODE_ENV=development
# Base URL of the SPA used in password-reset links. REQUIRED in production —
# reset emails are not sent without it (it is never taken from request headers).
PUBLIC_APP_URL=http://localhost:5173

# Razorpay (server-side). The key secret and webhook secret must never be sent
# to any browser or stored in platform_settings.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
REDIS_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Only for the seed scripts (backend/seed_admin.cjs, backend/seed_superadmin.js).
# Set them in your shell for a single run; do not keep real values in .env.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_SUPERADMIN_EMAIL=
# SEED_SUPERADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Bank data encryption (advisor bank accounts, BE-11)
# ---------------------------------------------------------------------------
# REQUIRED to add or edit advisor bank accounts and to reveal them for payout.
# 32 random bytes, as 64 hex characters or base64. Without it the bank-account
# endpoints answer 503 and nothing is stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of source control and back it up separately from the database:
# losing the key makes stored account numbers unrecoverable.
BANK_DATA_KEY=
