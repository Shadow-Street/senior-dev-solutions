{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./backend/.env)",
      "Read(./backend/.env.local)",
      "Read(./backend/.env.production)",
      "Read(./backup*.sql)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(npm audit fix --force*)",
      "Bash(node backend/scripts/reset-schema.js*)",
      "Bash(node scripts/reset-schema.js*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(npm install*)",
      "Bash(npm --prefix backend install*)",
      "Bash(node backend/seed_*)",
      "Bash(node backend/fix_*)",
      "Bash(node backend/scripts/*)",
      "Bash(mysql *)"
    ],
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm --prefix backend test*)",
      "Bash(npm --prefix backend run test*)",
      "Bash(node scripts/tracker.mjs*)",
      "Bash(npx eslint *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/tracker.mjs\" summary --brief 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
