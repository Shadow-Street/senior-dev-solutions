{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=4000",
        "npm",
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "api-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=4001",
        "npm",
        "--prefix",
        "backend",
        "run",
        "dev"
      ],
      "port": 4001
    },
    {
      "name": "frontend-test",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_URL=http://localhost:4001/api",
        "VITE_WS_URL=ws://localhost:4001",
        "npx",
        "vite",
        "--port",
        "8081",
        "--strictPort"
      ],
      "port": 8081
    }
  ]
}